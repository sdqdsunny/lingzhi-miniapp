{
    "bsonType": "object",
    "required": [
        "user_id",
        "product_id",
        "amount",
        "status"
    ],
    "permission": {
        "read": "auth.uid == doc.user_id",
        "create": "auth.uid != null",
        "update": "false",
        "delete": "false"
    },
    "indexes": [
        {
            "keys": {
                "user_id": 1
            }
        },
        {
            "keys": {
                "status": 1
            }
        }
    ],
    "properties": {
        "_id": {
            "description": "ID，系统自动生成"
        },
        "user_id": {
            "bsonType": "string",
            "description": "用户ID",
            "foreignKey": "uni-id-users._id"
        },
        "product_id": {
            "bsonType": "string",
            "description": "商品ID"
        },
        "amount": {
            "bsonType": "double",
            "description": "订单金额"
        },
        "status": {
            "bsonType": "string",
            "description": "订单状态: PENDING-待支付, PAID-已支付, QUEUED-排队中, COMPLETED-已完成/免单",
            "enum": [
                "PENDING",
                "PAID",
                "QUEUED",
                "COMPLETED"
            ]
        },
        "create_date": {
            "bsonType": "timestamp",
            "description": "创建时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}